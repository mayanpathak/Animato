# Development defaults. The dev run talks to the real api_server through the
# Vite proxy (VITE_API_TARGET, default http://localhost:5000). See LOCAL_DEV.md
# at the repo root for starting the backend.
#
# Mocks (MSW) exist only for the Playwright e2e build: `npm run build:mocks`
# sets VITE_USE_MOCKS=true for that build. Do not turn them on here.
VITE_USE_MOCKS=false
